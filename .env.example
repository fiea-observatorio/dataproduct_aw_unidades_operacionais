# =============================================================================
# PADRÃO — valores iguais em qualquer ambiente
# =============================================================================
FLASK_APP=run.py
# Gere valores aleatórios fortes (ex.: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ACCESS_TOKEN_EXPIRES=7200
JWT_REFRESH_TOKEN_EXPIRES=2592000

# Banco Data Warehouse - dw (o mesmo para todos os ambientes)
DATABASE_URL_DW=mssql+pyodbc://USERNAME:PASSWORD@10.83.0.141/dw?driver=ODBC+Driver+17+for+SQL+Server

# Power BI
POWERBI_TENANT_ID=your-azure-tenant-id
POWERBI_CLIENT_ID=your-azure-client-id
POWERBI_CLIENT_SECRET=your-azure-client-secret
POWERBI_AUTHORITY_URL=https://login.microsoftonline.com/your-tenant-id
POWERBI_SCOPE=https://analysis.windows.net/powerbi/api/.default

# =============================================================================
# DINÂMICAS — trocam entre homologação e produção (ative um bloco por vez)
# IDIGITAL_APPLICATION_HOST deve ser idêntico ao do front (é o "aud" dos
# access tokens do iDigital). ALLOW_PASSWORD_LOGIN nunca deve ir a 1 fora do
# desenvolvimento local.
# =============================================================================

# --- Produção ----------------------------------------------------------------
FLASK_ENV=production
DATABASE_URL=mssql+pyodbc://USERNAME:PASSWORD@10.83.0.141:1433/plataforma_unidades?driver=ODBC+Driver+17+for+SQL+Server
ALLOW_PASSWORD_LOGIN=0
IDIGITAL_ISSUER=https://sso.idigital.sistemafiea.com.br
IDIGITAL_CLIENT_ID=your-idigital-prod-client-id
IDIGITAL_APPLICATION_HOST=https://plataformaunidades.sistemafiea.com.br
CORS_ORIGINS=https://plataformaunidades.sistemafiea.com.br

# --- Homologação -------------------------------------------------------------
# FLASK_ENV=production
# DATABASE_URL=mssql+pyodbc://USERNAME:PASSWORD@10.83.0.140:1433/plataforma_unidades_homol?driver=ODBC+Driver+17+for+SQL+Server
# ALLOW_PASSWORD_LOGIN=0
# IDIGITAL_ISSUER=https://sso-homo.idigital.sistemafiea.com.br
# IDIGITAL_CLIENT_ID=your-idigital-homol-client-id
# IDIGITAL_APPLICATION_HOST=https://plataformaunidades-homol.sistemafiea.com.br
# CORS_ORIGINS=https://plataformaunidades-homol.sistemafiea.com.br

# --- Desenvolvimento local (client de dev, no SSO de dev) --------------------
# Aponte DATABASE_URL para o banco desejado (homol ou produção).
# FLASK_ENV=development
# DATABASE_URL=mssql+pyodbc://USERNAME:PASSWORD@10.83.0.140:1433/plataforma_unidades_homol?driver=ODBC+Driver+17+for+SQL+Server
# ALLOW_PASSWORD_LOGIN=1
# IDIGITAL_ISSUER=https://sso-dev.idigital.sistemafiea.com.br
# IDIGITAL_CLIENT_ID=your-idigital-dev-client-id
# IDIGITAL_APPLICATION_HOST=http://localhost:3000
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
