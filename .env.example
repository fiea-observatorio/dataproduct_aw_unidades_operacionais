# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production

# Database - SQL Server
DATABASE_URL=mssql+pyodbc://username:password@host:1433/database?driver=ODBC+Driver+17+for+SQL+Server

# Banco Data Warehouse - dw
DATABASE_URL_DW=mssql+pyodbc://USERNAME:PASSWORD@10.83.0.141/dw?driver=ODBC+Driver+17+for+SQL+Server

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# Power BI Configuration (commented out - not in use)
# POWERBI_CLIENT_ID=your-azure-client-id
# POWERBI_CLIENT_SECRET=your-azure-client-secret
# POWERBI_TENANT_ID=your-azure-tenant-id
# POWERBI_AUTHORITY_URL=https://login.microsoftonline.com/your-tenant-id
# POWERBI_SCOPE=https://analysis.windows.net/powerbi/api/.default

# Login por senha de desenvolvimento (0 ou ausente = desligado; nunca ligar em produção)
ALLOW_PASSWORD_LOGIN=0

# iDigital SSO (FIEA)
# O client id e o application host devem bater com o cadastro do ambiente no
# iDigital (dev: sso-dev | homologação: sso-homo | produção: sso). O
# application host é a URL do front cadastrada — é o "aud" dos access tokens.
IDIGITAL_ISSUER=https://sso-homo.idigital.sistemafiea.com.br
IDIGITAL_CLIENT_ID=your-idigital-client-id
IDIGITAL_APPLICATION_HOST=https://plataformaunidades-homol.sistemafiea.com.br

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
